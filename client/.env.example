# Copy to client/.env.local to override locally. client/.env.local is git-ignored.
# This file contains no secrets, and none should ever be added to a VITE_ variable,
# because Vite inlines every VITE_ value into the public JavaScript bundle.

# Production API origin. Vite reads this at BUILD time.
#
# Leave empty for local development. The app then sends same-origin requests to
# /api/..., and the Vite dev/preview proxy forwards them to the Express server.
#
# When set, use an https origin (plain http is accepted only for localhost), with no
# query string, fragment, or credentials. A path prefix is allowed.
# Example: VITE_API_BASE_URL=https://noaa-api.example.org
VITE_API_BASE_URL=

# Not a VITE_ variable. Set it in the shell when the local API is not on port 4200:
#   API_PROXY_TARGET=http://localhost:4300 npm run dev
